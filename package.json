{
  "name": "@agntn/sessions",
  "version": "0.1.0",
  "description": "Read normalized AI coding sessions across harnesses.",
  "keywords": [
    "agents",
    "ai",
    "claude",
    "codex",
    "gemini",
    "harness",
    "pi-package",
    "sessions"
  ],
  "homepage": "https://github.com/agntn/sessions#readme",
  "bugs": "https://github.com/agntn/sessions/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/sessions.git"
  },
  "bin": {
    "sessions": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "0.2.2",
    "typebox": "1.3.33"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oh-my-pi/omptype": "^18.0.0",
    "@oh-my-pi/pi-coding-agent": "^18.0.0",
    "@types/node": "25.3.5",
    "changelogen": "0.6.2",
    "obuild": "0.4.40",
    "oxfmt": "0.63.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "omp": {
    "extensions": [
      "./packages/omp/extensions/sessions.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
