{
  "name": "memxa",
  "version": "0.1.0",
  "description": "Universal AI conversation memory. Ingest sessions from any coding assistant into a single searchable store.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oritwoen/memxa.git"
  },
  "homepage": "https://github.com/oritwoen/memxa#readme",
  "bugs": "https://github.com/oritwoen/memxa/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./sources": {
      "types": "./dist/sources/index.d.mts",
      "import": "./dist/sources/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "memxa": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "obuild",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev:prepare": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "keywords": [
    "ai",
    "memory",
    "conversation",
    "ingest",
    "claude",
    "codex",
    "gemini",
    "sqlite",
    "search"
  ],
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "changelogen": "^0.6.2",
    "drizzle-kit": "^0.31.9",
    "obuild": "^0.4.31",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
