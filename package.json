{
  "name": "@agntn/sessions",
  "version": "0.1.0",
  "description": "Read normalized AI coding sessions across harnesses.",
  "keywords": [
    "agents",
    "ai",
    "claude",
    "codex",
    "gemini",
    "grok",
    "harness",
    "openbot",
    "pi-package",
    "sessions",
    "vibe"
  ],
  "homepage": "https://github.com/agntn/sessions#readme",
  "bugs": "https://github.com/agntn/sessions/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/sessions.git"
  },
  "bin": {
    "sessions": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./tool-operations": {
      "types": "./dist/tool-operations.d.mts",
      "import": "./dist/tool-operations.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "import": "./dist/tools.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/tools": "0.3.2",
    "@libsql/client": "0.15.15",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@oh-my-pi/pi-coding-agent": "18.20.2",
    "@types/node": "25.3.5",
    "changelogen": "0.6.2",
    "obuild": "0.4.45",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/omp/sessions.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/*.ts"
    ]
  }
}
