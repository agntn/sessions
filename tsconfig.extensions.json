{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@agntn/sessions": ["./src/index.ts"]
    },
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "extensions/omp/**/*.ts",
    "extensions/pi/**/*.ts",
    "test/unit/omp-extension.test.ts",
    "test/unit/pi-extension*.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
